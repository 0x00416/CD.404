#include <windows.h>
#include "resource.h"

IDR_CD404_APPLICATION RCDATA "@CD404_APPLICATION_RESOURCE@"
IDR_CD404_PRIVACY RCDATA "@CD404_PRIVACY_RESOURCE@"
IDR_CD404_NOTICES RCDATA "@CD404_NOTICES_RESOURCE@"
IDR_CD404_FONT RCDATA "@CD404_FONT_RESOURCE@"
IDR_CD404_FONT_LICENSE RCDATA "@CD404_FONT_LICENSE_RESOURCE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CD.404 contributors\0"
            VALUE "FileDescription", "CD.404 原生每用户安装程序\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "CD.404.Setup\0"
            VALUE "OriginalFilename", "CD.404-@PROJECT_VERSION@-public-beta.1-x64-setup.exe\0"
            VALUE "ProductName", "CD.404\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@-public-beta.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

