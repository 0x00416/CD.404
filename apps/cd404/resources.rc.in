#include <windows.h>

201 RCDATA "@PROJECT_SOURCE_DIR@/assets/ui/vu-meter-photoreal-calibrated.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "CD.404 contributors\0"
            VALUE "FileDescription", "CD.404 native audio CD player\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "CD.404\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 CD.404 contributors\0"
            VALUE "OriginalFilename", "CD.404.exe\0"
            VALUE "ProductName", "CD.404\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@-public-beta.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
